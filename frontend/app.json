{
  "expo": {
    "name": "Sanarch",
    "slug": "sanarch",
    "scheme": "sanarch",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#004D36",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.sanarch.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Sanarch needs camera access to scan medical documents.",
        "NSPhotoLibraryUsageDescription": "Sanarch needs photo library access to upload medical documents."
      }
    },
    "android": {
      "package": "com.sanarch.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#004D36"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-local-authentication",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ]
  }
}
