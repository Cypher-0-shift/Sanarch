rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks that the Sanarch user document's firebase_uid matches the signed-in Firebase user
    function isOwner(sanarchUserId) {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(sanarchUserId)).data.firebase_uid == request.auth.uid;
    }

    // Allow users to read their own Sanarch user document.
    // This is also required so the isOwner() helper's get() call can resolve during rules evaluation.
    match /users/{ownerId} {
      allow read: if isOwner(ownerId);
      allow write: if false; // All writes go through the backend
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data.owner_id);
      allow write: if false; // All writes must go through the backend
    }

    // Notifications: users can read all their notifications and update only the 'read' field
    match /users/{ownerId}/notifications/{notifId} {
      allow read: if isOwner(ownerId);
      allow update: if isOwner(ownerId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}

